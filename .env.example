# PathFinder strict/base profile
#
# Copy to `.env` and fill in every required value:
#   cp .env.example .env
#
# This file is for production/staging-style startup. Local-development
# conveniences live in `.env.dev.example` and the `*.dev.yml` overlays.

# ── Core runtime (required) ──────────────────────────────────────────────────
API_ENV=production
API_SECRET_KEY=
DATABASE_URL=
# Docker Compose: http://api:8000
# Direct web run: http://localhost:8000
NEXT_PUBLIC_API_URL=

# ── Model backend (required)
# Set PATHFINDER_CHAT_PROVIDER=default and configure at least one provider
# or an explicit Ollama base URL. Mock mode is test-only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=
PATHFINDER_CHAT_PROVIDER=
DEFAULT_PROVIDER=anthropic
DEFAULT_TIER=default

# ── Security (optional) ─────────────────────────────────────────────────────
# Set to false to skip loading the PIGuard prompt-injection model and the
# per-message input scan. Defaults to true.
PIGUARD_ENABLED=true

# ── Background worker (optional) ────────────────────────────────────────────
# Jobs the Procrastinate worker runs in parallel, across every queue.
WORKER_CONCURRENCY=4

# ── Observability (optional, but explicit when enabled) ─────────────────────
# Set to true to export prompts, completions, and tool arguments in agent
# traces. Defaults to false.
OTEL_INCLUDE_CONTENT=false

# External/production SigNoz
SIGNOZ_OTEL_ENDPOINT=
SIGNOZ_TRACE_OTEL_HTTP_ENDPOINT=

# Optional self-hosted SigNoz bootstrap values
SIGNOZ_TOKENIZER_JWT_SECRET=
SIGNOZ_ROOT_USER_EMAIL=
SIGNOZ_ROOT_USER_PASSWORD=
# Development/local-only ClickHouse shortcut for self-hosted SigNoz.
SIGNOZ_CLICKHOUSE_SKIP_USER_SETUP=

# External/production Langfuse
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── Self-hosted observability overrides (only for docker-compose.observability.dev.yml)
LANGFUSE_POSTGRES_USER=
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_POSTGRES_DB=
LANGFUSE_CLICKHOUSE_USER=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_MINIO_ROOT_USER=
LANGFUSE_MINIO_ROOT_PASSWORD=
LANGFUSE_REDIS_AUTH=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=

# ── Research / site integrations (optional) ─────────────────────────────────
# VEUPATHDB_SITES_CONFIG=/path/to/my-sites.yaml
S2_API_KEY=
