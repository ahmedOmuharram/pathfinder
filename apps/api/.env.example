# Pathfinder API strict profile
#
# Copy this file to `.env` when running the API directly from `apps/api/`.
# The API fails closed by default: set every required value explicitly.

API_ENV=production
API_SECRET_KEY=
DATABASE_URL=
REDIS_URL=
PATHFINDER_CHAT_PROVIDER=

# Configure at least one real model backend. Mock mode is test-only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=

DEFAULT_PROVIDER=anthropic
DEFAULT_TIER=default

# Jobs the Procrastinate worker runs in parallel, across every queue.
WORKER_CONCURRENCY=4

# Age at which a job still in 'doing' is failed so its lock releases and the
# chat stream it left open ends. Minimum 300.
WORKER_STALLED_JOB_TIMEOUT_SECONDS=3600

# Seconds of silence after which the chat SSE stream sends a comment frame.
# Minimum 1.
SSE_KEEPALIVE_SECONDS=15

# Optional observability
# Set to true to export prompts, completions, and tool arguments in agent traces.
OTEL_INCLUDE_CONTENT=false
SIGNOZ_OTEL_ENDPOINT=
SIGNOZ_TRACE_OTEL_HTTP_ENDPOINT=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
