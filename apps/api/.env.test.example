# Pathfinder API test profile
#
# Copy this file to `.env` when running the API directly from `apps/api/`
# for tests or mock-only harnesses.

API_ENV=test
API_SECRET_KEY=pathfinder-test-secret-key-test-secret-key-test
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pathfinder_test
REDIS_URL=redis://localhost:6379/1
PATHFINDER_CHAT_PROVIDER=mock

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=

DEFAULT_PROVIDER=anthropic
DEFAULT_TIER=balanced

SIGNOZ_OTEL_ENDPOINT=
SIGNOZ_TRACE_OTEL_HTTP_ENDPOINT=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
