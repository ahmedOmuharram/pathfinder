# Pathfinder API development profile
#
# Copy this file to `.env` when running the API directly from `apps/api/`
# against local services.

API_ENV=development
API_SECRET_KEY=pathfinder-dev-secret-key-change-me-1234567890
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pathfinder
REDIS_URL=redis://localhost:6379/0
PATHFINDER_CHAT_PROVIDER=default

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

DEFAULT_PROVIDER=anthropic
DEFAULT_TIER=balanced

SIGNOZ_OTEL_ENDPOINT=
SIGNOZ_TRACE_OTEL_HTTP_ENDPOINT=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
