# PathFinder test profile
#
# Usage:
#   cp .env.test.example .env.test
#   docker compose --env-file .env.test \
#     -f docker-compose.yml \
#     -f docker-compose.dev.yml \
#     -f docker-compose.e2e.yml \
#     up -d --build api web
#
# This profile is the only place mock mode should be enabled.

API_ENV=test
API_SECRET_KEY=pathfinder-test-secret-key-test-secret-key-test
PATHFINDER_CHAT_PROVIDER=mock
NEXT_PUBLIC_API_URL=http://api:8000

DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/pathfinder
REDIS_URL=redis://redis:6379/1

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=
DEFAULT_PROVIDER=anthropic
DEFAULT_TIER=balanced
