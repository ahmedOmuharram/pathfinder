{
  "name": "@pathfinder/shared",
  "version": "0.1.0-alpha",
  "description": "Shared TypeScript types for Pathfinder",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "kubb",
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@kubb/cli": "^4.37.2",
    "@kubb/core": "^4.37.2",
    "@kubb/plugin-oas": "^4.37.2",
    "@kubb/plugin-react-query": "^4.37.2",
    "@kubb/plugin-ts": "^4.37.2",
    "@kubb/plugin-zod": "^4.37.2",
    "@kubb/react-fabric": "^0.14.0",
    "@types/node": "^25.3.5",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": "./src/index.ts",
    "./generated/*": "./src/generated/*"
  }
}
