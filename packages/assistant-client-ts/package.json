{
  "name": "@pathfinder/assistant-client",
  "version": "0.1.0-alpha.1",
  "description": "A headless client for the assistant runtime wire protocol",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "sync:protocol": "node scripts/sync-protocol.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts",
    "./ai-sdk": "./src/ai-sdk.ts",
    "./legacy": "./src/legacy.ts"
  },
  "peerDependencies": {
    "ai": "^6.0.154"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.3.5",
    "ai": "^6.0.154",
    "eslint": "^9.39.4",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.2",
    "zod": "^4.3.6"
  }
}
